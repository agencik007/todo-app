{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/assets/i18n/*.json"
        ]
      },
      "cacheQueryOptions": {
        "ignoreSearch": true
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/media/**",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/auth/**",
    "!/users/**",
    "!/groups/**",
    "!/uploads/**",
    "!/docs",
    "!/redoc",
    "!/openapi.json",
    "!/health"
  ],
  "navigationRequestStrategy": "performance"
}
