# Docker Compose Environment Variables
#
# Copy this file to `docker/docker.env` (gitignored) and fill in real values.
# `make dev` / `make quick-dev` load it automatically via --env-file.
# For a production-like run, see docker.prod.env instead.

# Database Configuration
POSTGRES_USER=todo_user_example
POSTGRES_PASSWORD=todo_password_example
POSTGRES_DB=todo_db_example
DATABASE_URL=postgresql://todo_user_example:todo_password_example@db:5432/todo_db_example

# Application Settings
# Compose interpolates `$` in this file. Write a literal dollar sign as `$$`.
# REQUIRED: replace with a random value of at least 32 characters. The placeholder
# below is on the backend's blocklist, so the backend refuses to start with it.
# Generate one with `openssl rand -hex 32`, or in PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=False

# Hosts the backend accepts requests for, and origins allowed by CORS
# (comma-separated). The defaults in docker-compose.yml work for localhost;
# set these when the app is served from a real domain.
# ALLOWED_HOSTS=localhost,127.0.0.1,backend
# CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Native mobile apps (Capacitor) call the API from their own origins - add
# them to CORS_ORIGINS when the mobile app talks to this backend:
# CORS_ORIGINS=https://todo.example.com,capacitor://localhost,https://localhost

# Public URL the browser calls the API at, baked into the frontend image at build
# time (rebuild after changing it). Behind an HTTPS reverse proxy that routes
# /auth, /todos, /users, /groups and /uploads to the backend, set it to the site
# origin and mark cookies Secure:
# API_URL=https://todo.example.com
# SECURE_COOKIES=True
# Hostnames the Angular SSR server accepts (keep localhost for the healthcheck).
# Unset, every page falls back to client-side rendering.
# NG_ALLOWED_HOSTS=todo.example.com,localhost,127.0.0.1

# Email Configuration
EMAIL_FROM=noreply@example.com
FRONTEND_URL=http://localhost:4200

# ── Email mode ────────────────────────────────────────────────────────────────
# USE_MAILHOG=true  → dev mode:  emails captured by MailHog (http://localhost:8025)
# USE_MAILHOG=false → prod mode: emails sent via real SMTP (see docker.prod.env)
USE_MAILHOG=true

# MailHog (dev) — SMTP server inside docker network
MAILHOG_HOST=mailhog
MAILHOG_PORT=1025
#
# MailHog Web UI: http://localhost:8025
# All sent emails appear there instead of being delivered to real inboxes.

# PgAdmin (optional database management).
# Use a normal domain. pgAdmin rejects reserved names such as .local.
PGADMIN_EMAIL=admin@todo.dev
PGADMIN_PASSWORD=admin123

# ── Reverse proxy trust ────────────────────────────────────────────────────────
# If you put a reverse proxy (nginx, a load balancer, ...) in front of the
# backend, set this to its IP/CIDR so rate limiting and logging see the real
# client IP instead of the proxy's. Leave unset/127.0.0.1 if there is none.
# FORWARDED_ALLOW_IPS=172.16.0.0/12
