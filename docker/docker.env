# Docker Compose Environment Variables

# Database Configuration
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=todo_password
POSTGRES_DB=todo_db
DATABASE_URL=postgresql://todo_user:todo_password@db:5432/todo_db

# Application Settings
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=False

# Email Configuration
EMAIL_FROM=noreply@example.com
FRONTEND_URL=http://localhost:4200

# MailHog Configuration (for development/testing)
# MailHog is a development SMTP server that captures all emails
# It's automatically configured via docker-compose
# 
# How to use MailHog:
# 1. Start MailHog: docker-compose up mailhog (or docker-compose up to start all services)
# 2. Access MailHog Web UI: http://localhost:8025
# 3. All emails sent by the application will appear in the MailHog web interface
# 4. You can view email content, headers, and test email functionality without sending real emails
# 
# MailHog SMTP server runs on port 1025 (configured automatically)

# PgAdmin (optional database management)
PGADMIN_EMAIL=admin@todo.local
PGADMIN_PASSWORD=admin123
