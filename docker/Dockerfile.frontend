# Frontend Dockerfile - Angular application (Dev & Prod support)

FROM node:22-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install exactly what package-lock.json pins - reproducible builds
RUN npm ci

# Copy source code
COPY frontend/ .

# Expose port
EXPOSE 4200

# Set port environment variable
ENV PORT=4200

# URL the browser calls the API at, baked into the production bundle.
# The default matches environment.prod.ts (local/e2e stack); set it to the public
# origin when deploying behind a reverse proxy.
ARG API_URL=http://localhost:8000
RUN sed -i "s|apiUrl: '.*'|apiUrl: '${API_URL}'|" src/environments/environment.prod.ts \
  && grep -qF "apiUrl: '${API_URL}'" src/environments/environment.prod.ts

# By default, run the build and start the SSR server
# In development, this will be overridden by docker-compose
RUN npm run build
CMD ["node", "dist/frontend/server/server.mjs"]
