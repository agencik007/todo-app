# Frontend Dockerfile - Angular application (Production build)

FROM node:22-alpine AS build

# Set working directory
WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies (fresh install to avoid platform conflicts)
RUN npm install

# Copy source code
COPY frontend/ .

# Build the application for production
RUN npm run build --configuration=production

# Production stage - Serve with Angular SSR (Node.js)
FROM node:22-alpine

# Set working directory
WORKDIR /app

# Copy built application and server from build stage
# Note: we copy the whole dist/frontend which contains 'browser' and 'server'
COPY --from=build /app/dist/frontend/ .

# Expose port
EXPOSE 4200

# Set port environment variable
ENV PORT=4200

# Run the SSR server
CMD ["node", "server/server.mjs"]
