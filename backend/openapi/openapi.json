            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Forgot Password",
        "description": "Request password reset.\n\nAlways returns success to prevent email enumeration attacks.\n\nArgs:\n    request: FastAPI request object (for rate limiting).\n    reset_request: Password reset request with email.\n    db: Database session.\n    \nReturns:\n    dict: Generic success message.",
        "operationId": "forgot_password_auth_forgot_password_post",
