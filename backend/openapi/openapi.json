        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "description": "Logout endpoint.\n\nNote: With JWT tokens, logout is handled client-side by discarding tokens.\n\nArgs:\n    current_user: Current authenticated user.\n    \nReturns:\n    dict: Success message.",
        "operationId": "logout_auth_logout_post",
