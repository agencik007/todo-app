{
  "openapi": "3.1.0",
  "info": {
    "title": "Todo API",
    "description": "A simple Todo application API built with FastAPI",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "description": "Register a new user.\n\nArgs:\n    request: FastAPI request object (for rate limiting).\n    user_data: User registration data.\n    db: Database session.\n    \nReturns:\n    UserResponse: The created user.\n    \nRaises:\n    HTTPException: If email is already registered.",
        "operationId": "register_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Login endpoint - accepts both form data and JSON.\n\nSupports two formats:\n- **Form data**: `username` (email) and `password` fields (OAuth2 standard)\n- **JSON body**: `{\"email\": \"...\", \"password\": \"...\"}` (frontend-friendly)\n\nArgs:\n    request: FastAPI request object.\n    db: Database session.\n    \nReturns:\n    Token: Access and refresh tokens.\n    \nRaises:\n    HTTPException: If credentials are invalid or user is inactive.",
        "operationId": "login_auth_login_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh Access Token",
        "description": "Refresh access token using refresh token.\n\nArgs:\n    request: Refresh token request.\n    db: Database session.\n    \nReturns:\n    Token: New access and refresh tokens.\n    \nRaises:\n    HTTPException: If refresh token is invalid or user not found.",
        "operationId": "refresh_access_token_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Get Current User Info",
        "description": "Get current user information.\n\nArgs:\n    current_user: Current authenticated user.\n    \nReturns:\n    UserResponse: Current user's profile information.",
        "operationId": "get_current_user_info_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
